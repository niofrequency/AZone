# Copy to deploy/.env and fill in. Never commit the real file.

# The public address people use, without a trailing slash
SITE_URL=https://azone.example.com
CSRF_TRUSTED_ORIGINS=https://azone.example.com

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Needed for logging in from the wger mobile app. Generate once with
#   docker compose -f deploy/docker-compose.yml run --rm web python3 manage.py generate-jwt-keys
# and paste the two lines here
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

DJANGO_DB_DATABASE=wger
DJANGO_DB_USER=wger
DJANGO_DB_PASSWORD=change-me-too

TIME_ZONE=America/Los_Angeles

# Let other people create accounts
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False

# Behind a TLS-terminating proxy (Caddy, Cloudflare, a load balancer):
# X_FORWARDED_PROTO_HEADER_SET=True
# NUMBER_OF_PROXIES=1

# Port nginx listens on, on the host
# AZONE_PORT=80

# Optional: download wger's ingredient database on first start, for food search
# (large, takes a while). Or run it once later, see deploy/README.md
LOAD_ONLINE_FIXTURES_ON_STARTUP=False

# Email (password resets). Off by default
ENABLE_EMAIL=False
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# FROM_EMAIL=AZone <noreply@example.com>
